#!/usr/bin/env bash
# Susanoo — check task prerequisites and resolve the tasks template.
#
# Port of spec-kit's setup_tasks.py. Does not create tasks.md; it validates spec.md and
# plan.md and emits the template for the tasks stage to fill. JSON on stdout with --json.
set -euo pipefail

source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib/common.sh"

usage() {
  cat >&2 <<'EOF'
Usage: setup_tasks [--json] [--help|-h]
EOF
}

json_mode=0
while [ $# -gt 0 ]; do
  case "$1" in
    --json) json_mode=1 ;;
    --help|-h) usage; exit 0 ;;
    *) die "Unknown option '$1'" ;;
  esac
  shift
done

resolve_feature_paths 0
feature_dir="$SUSANOO_FEATURE_DIR"
feature_spec="$feature_dir/spec.md"
impl_plan="$feature_dir/plan.md"

[ -f "$impl_plan" ] || die "plan.md not found in $feature_dir. Run scripts/setup_plan first to create the implementation plan."
[ -f "$feature_spec" ] || die "spec.md not found in $feature_dir. Run scripts/new_feature first to create the feature structure."

# Available plan-phase docs (newline-separated).
available_docs() {
  [ -f "$feature_dir/research.md" ] && echo "research.md"
  [ -f "$feature_dir/data-model.md" ] && echo "data-model.md"
  if [ -d "$feature_dir/contracts" ] && [ -n "$(ls -A "$feature_dir/contracts" 2>/dev/null)" ]; then
    echo "contracts/"
  fi
  [ -f "$feature_dir/quickstart.md" ] && echo "quickstart.md"
}

tmpl="$(templates_dir)/tasks-template.md"
[ -f "$tmpl" ] || die "Could not resolve required tasks-template from $tmpl. Restore a valid tasks-template.md and rerun."
tasks_content="$(cat "$tmpl")"

if [ "$json_mode" -eq 1 ]; then
  docs_json=""
  while IFS= read -r d; do
    [ -z "$d" ] && continue
    if [ -z "$docs_json" ]; then docs_json="\"$(json_str "$d")\""; else docs_json="$docs_json,\"$(json_str "$d")\""; fi
  done <<< "$(available_docs)"
  printf '{"FEATURE_DIR":"%s","AVAILABLE_DOCS":[%s],"TASKS_TEMPLATE":"%s","TASKS_TEMPLATE_CONTENT":"%s"}\n' \
    "$(json_str "$feature_dir")" "$docs_json" "$(json_str "$tmpl")" "$(json_str "$tasks_content")"
else
  printf 'FEATURE_DIR: %s\n' "$feature_dir"
  printf 'TASKS_TEMPLATE: %s\n' "$tmpl"
  printf 'AVAILABLE_DOCS:\n'
  mark_file() { if [ -f "$1" ]; then printf '  [OK] %s\n' "$2"; else printf '  [--] %s\n' "$2"; fi; }
  mark_file "$feature_dir/research.md" "research.md"
  mark_file "$feature_dir/data-model.md" "data-model.md"
  if [ -d "$feature_dir/contracts" ] && [ -n "$(ls -A "$feature_dir/contracts" 2>/dev/null)" ]; then
    printf '  [OK] %s\n' "contracts/"
  else
    printf '  [--] %s\n' "contracts/"
  fi
  mark_file "$feature_dir/quickstart.md" "quickstart.md"
fi
