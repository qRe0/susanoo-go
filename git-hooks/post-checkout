#!/usr/bin/env bash
# Susanoo — link gitignored projects/ and .susanoo/ into new worktrees (post-checkout).
#
# `git worktree add` fires post-checkout with a null previous-HEAD ($1 all zeros).
# Enhance-only: existing paths are never replaced.
set -uo pipefail

case "${1:-}" in
  0000000000000000000000000000000000000000) ;;
  *) exit 0 ;;
esac

root="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
script="${SUSANOO_SCRIPTS:-$root/scripts}/link_worktree_state"
[ -x "$script" ] || script="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/scripts/link_worktree_state"
[ -x "$script" ] && "$script" "$root" || true
exit 0
